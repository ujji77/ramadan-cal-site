---
import InstallBar from "./InstallBar.tsx";
import Terminal from "./Terminal.tsx";
---

<section class="pt-[140px] pb-20 px-6 sm:pt-[100px] sm:pb-[60px] flex flex-col items-center text-center">
  <h1
    class="font-mono font-bold tracking-[-0.04em] leading-[0.85] mb-6 animate-fade-up"
    style="font-size: clamp(64px, 14vw, 160px); animation-delay: 0.2s;"
  >
    <span style="color: var(--text);">RAMADAN</span><span style="color: var(--accent);">CAL</span>
  </h1>

  <p
    class="text-[17px] mb-10 max-w-md animate-fade-up"
    style="color: var(--text-secondary); animation-delay: 0.4s;"
  >
    Ramadan 2026 prayer times, calendar, and Eid countdown — in Claude Code and your terminal.
  </p>

  <div class="animate-fade-up" style="animation-delay: 0.6s;">
    <InstallBar client:visible />
  </div>

  <div class="w-full max-w-[680px] mt-12 animate-fade-up" style="animation-delay: 0.8s;">
    <Terminal client:visible />
  </div>
</section>
