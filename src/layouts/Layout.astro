---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ramadan-cal — Ramadan 2026 Calendar & Prayer Times for Claude Code and Your Terminal",
  description = "Ramadan 2026 (1447 Hijri) calendar and prayer times for Claude Code and your terminal. Installs as a Claude Code skill automatically — just type ramadan to get fasting times, Eid countdown, and daily Ramadan progress without leaving your coding session.",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content="ramadan 2026, ramadan calendar, prayer times terminal, ramadan cli, eid countdown, hijri calendar 1447, fasting schedule, suhoor iftar times, claude code, claude code skills, claude code ramadan, anthropic claude tools, claude code commands, developer ramadan tools" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://ramadan-cal.vercel.app" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="canonical" href="https://ramadan-cal.vercel.app" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <!-- Theme initialization (prevents flash) -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const system = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        const theme = stored || system;
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body class="min-h-screen">
    <slot />
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
